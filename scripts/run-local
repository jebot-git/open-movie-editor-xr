#!/bin/sh
set -eu
ome_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export LD_LIBRARY_PATH="$ome_root/.deps/install/lib:$ome_root/.deps/sysroot/usr/lib64:/opt/fltk-vr/toolkit/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LIBQUICKTIME_PLUGIN_DIR="$ome_root/.deps/sysroot/usr/lib64/libquicktime"
export GMERLIN_PLUGIN_PATH="$ome_root/.deps/install/lib/gmerlin/plugins"
exec "$ome_root/build-original/openmovieeditor" "$@"
